//@version=6
indicator("GainzAlgo Suite", overlay=true)

// --- INPUTS ---
config_input = input.string("STANDARD", "Configuration", options=["STANDARD", "PRO", "V2 ESSENTIAL", "V2 PROFICIENT", "V2 ALPHA"])
license_key = input.string("STANDARD", "License Key")

// --- CONSTANTS ---
LOCKED_MSG = "Configuration Locked"

// --- SHARED HELPER FUNCTIONS ---

// Custom Dynamic EMA (Solves "series int" length issue with ta.ema)
f_dynamic_ema(src, len) =>
    alpha = 2.0 / (len + 1.0)
    var float ema = na
    ema := na(ema) ? src : alpha * src + (1.0 - alpha) * nz(ema[1])
    ema

// Custom Volatility
f_get_volatility(length) =>
    ta.atr(length)

// Custom Momentum (Smoothed Rate of Change)
f_get_momentum(src, len) =>
    ta.ema(src - src[len], len)

// Custom Trend (Double EMA)
f_get_trend(src, len_fast, len_slow) =>
    ta.ema(src, len_fast) > ta.ema(src, len_slow)

// Candle Structure (Bullish/Bearish Engulfing or Pinbar)
f_candle_structure() =>
    body = math.abs(close - open)
    upper_wick = high - math.max(close, open)
    lower_wick = math.min(close, open) - low

    // Relaxed Engulfing: Allow equal open/close (no gap required)
    bullish_eng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    bearish_eng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

    bullish_pin = lower_wick > body * 2 and upper_wick < body
    bearish_pin = upper_wick > body * 2 and lower_wick < body

    [bullish_eng or bullish_pin, bearish_eng or bearish_pin]

// --- STANDARD CONFIGURATION ---
f_calc_standard() =>
    // 1. Structure
    [bull_struct, bear_struct] = f_candle_structure()

    // 2. Volatility (Range Validation - Total Range relative to ATR)
    atr = f_get_volatility(14)
    // Changed from Body > ATR*0.3 to Range > ATR*0.5 to allow Pinbars/Dojis with high volatility
    valid_volatility = (high - low) > (atr * 0.5)

    // 3. Momentum
    mom = f_get_momentum(close, 14)
    bull_mom = mom > 0
    bear_mom = mom < 0

    // 4. Trend
    bull_trend = f_get_trend(close, 20, 50)
    bear_trend = not bull_trend

    // Combination
    buy = bull_struct and valid_volatility and bull_mom and bull_trend
    sell = bear_struct and valid_volatility and bear_mom and bear_trend

    [buy, sell]

// --- PRO CONFIGURATION ---
f_calc_pro() =>
    // 1. CSMRM (Candle Structure Micro-Reversal Model) - Scale 0-10
    // Close near High = 10, Close near Low = 0
    range_len = high - low
    csmrm_score = range_len == 0 ? 5.0 : ((close - low) / range_len) * 10.0

    // 2. Percentile-ranked Volatility - Scale 0-10
    atr = ta.atr(14) // Extracted to avoid ternary consistency issue
    atr_max = ta.highest(atr, 50)
    atr_min = ta.lowest(atr, 50)
    vol_denom = atr_max - atr_min
    vol_score = vol_denom == 0 ? 5.0 : ((atr - atr_min) / vol_denom) * 10.0

    // 3. CSTA (Cycle-Slope Trend Analysis) - Scale 0-10
    // Positive Slope -> > 5, Negative Slope -> < 5
    ma = ta.ema(close, 20)
    slope = ma - ma[1]
    // Normalize: assume max reasonable slope is roughly ATR.
    // ATR is already calculated as 'atr'
    atr_denom = atr == 0 ? 1.0 : atr
    norm_slope = slope / atr_denom
    // Map -1 to 1 range to 0 to 10. 0 slope = 5.
    csta_score = math.max(0.0, math.min(10.0, 5.0 + (norm_slope * 5.0)))

    // 4. SAMSM (Momentum Acceleration Model) - Scale 0-10
    mom = close - close[4]
    accel = mom - mom[1]
    norm_accel = accel / atr_denom
    samsm_score = math.max(0.0, math.min(10.0, 5.0 + (norm_accel * 5.0)))

    // Weighted Sum
    total_score = (csmrm_score * 0.25) + (vol_score * 0.15) + (csta_score * 0.3) + (samsm_score * 0.3)

    // Adaptive Threshold
    threshold_upper = ta.sma(total_score, 20) + 0.5 // Buffer
    threshold_lower = ta.sma(total_score, 20) - 0.5

    // Signals
    // Buy: Score breaks above upper adaptive band
    // Sell: Score breaks below lower adaptive band
    buy = ta.crossover(total_score, threshold_upper)
    sell = ta.crossunder(total_score, threshold_lower)

    [buy, sell]

// --- V2 ESSENTIAL CONFIGURATION ---
f_calc_v2_essential() =>
    // Macro Bias (Slower behavioral modeling)
    macro_ma = ta.sma(close, 200)
    bullish_macro = close > macro_ma
    bearish_macro = close < macro_ma

    // Expanded Structural Evaluation (Longer window swings)
    highest_20 = ta.highest(high, 20)
    lowest_20 = ta.lowest(low, 20)

    // Structural Stability (ADX for trend strength)
    [diplus, diminus, adx] = ta.dmi(14, 14)
    stable_trend = adx > 20

    // Logic
    // Buy: Macro Bullish + Breakout of recent high + Stable Trend
    buy = bullish_macro and close > highest_20[1] and stable_trend
    sell = bearish_macro and close < lowest_20[1] and stable_trend

    [buy, sell]

// --- V2 PROFICIENT CONFIGURATION ---
f_calc_v2_proficient() =>
    // Adaptive Filtering
    // Calculate adaptive length based on volatility
    vol = ta.atr(14)
    vol_avg = ta.sma(vol, 50)
    // If vol is high, use shorter length (reactive). If low, use longer (noise reduction).
    // Clamp length between 10 and 50.
    len_adaptive = int(math.max(10, math.min(50, 20 * (vol_avg / (vol == 0 ? 1 : vol)))))

    // Mid-range responsiveness (Adaptive MA using Custom Dynamic EMA)
    adaptive_ma = f_dynamic_ema(close, len_adaptive)

    // Momentum-shift modeling (RSI with adaptive length logic)
    diff = close - close[1]
    // Use f_dynamic_ema because len_adaptive is a series int
    gain = f_dynamic_ema(math.max(diff, 0), len_adaptive)
    loss = f_dynamic_ema(math.max(-diff, 0), len_adaptive)
    rs = loss == 0 ? 100 : gain / loss
    rsi_adaptive = 100 - (100 / (1 + rs))

    // Conditional Layered Validation
    bullish_cond = close > adaptive_ma and rsi_adaptive > 50 and rsi_adaptive > rsi_adaptive[1]
    bearish_cond = close < adaptive_ma and rsi_adaptive < 50 and rsi_adaptive < rsi_adaptive[1]

    [bullish_cond, bearish_cond]

// --- V2 ALPHA CONFIGURATION ---
f_calc_v2_alpha() =>
    // Multi-phase micro-cycle evaluation (Fast Oscillators)
    fast_k = ta.stoch(close, high, low, 5) // Very fast
    slow_k = ta.sma(fast_k, 3)

    // Rapid Structural Shifts (Instantaneous trend)
    inst_trend = ta.linreg(close, 5, 0)
    trend_up = inst_trend > inst_trend[1]

    // Localized Momentum Surges (Volume/ATR)
    atr = ta.atr(5)
    atr_ma = ta.sma(atr, 20)
    surge = atr > atr_ma

    // Dynamic Interaction
    // Buy: Stoch oversold cross up + Trend Up + Surge
    buy = ta.crossover(fast_k, slow_k) and fast_k < 80 and trend_up and surge
    sell = ta.crossunder(fast_k, slow_k) and fast_k > 20 and not trend_up and surge

    [buy, sell]

// --- MAIN EXECUTION ---
f_validate_license(cfg, key) =>
    // License Key Validation
    key == cfg

is_locked = not f_validate_license(config_input, license_key)

// Display Locked Message
if is_locked and barstate.islast
    label.new(bar_index, high, LOCKED_MSG, color=color.red, textcolor=color.white, style=label.style_label_down)

// Calculate ALL configurations unconditionally to maintain internal history state
[std_b, std_s] = f_calc_standard()
[pro_b, pro_s] = f_calc_pro()
[ess_b, ess_s] = f_calc_v2_essential()
[prof_b, prof_s] = f_calc_v2_proficient()
[alp_b, alp_s] = f_calc_v2_alpha()

// Select the Output based on config
[b, s] = if not is_locked
    switch config_input
        "STANDARD" => [std_b, std_s]
        "PRO" => [pro_b, pro_s]
        "V2 ESSENTIAL" => [ess_b, ess_s]
        "V2 PROFICIENT" => [prof_b, prof_s]
        "V2 ALPHA" => [alp_b, alp_s]
        => [false, false]
else
    [false, false]

// Enforce Bar Close Confirmation (No Repainting)
buy_signal = b and barstate.isconfirmed
sell_signal = s and barstate.isconfirmed

// Plotting (Reverted to textcolor)
plotshape(buy_signal, "Buy", shape.labelup, location.belowbar, color.green, 0, "BUY", textcolor=color.white)
plotshape(sell_signal, "Sell", shape.labeldown, location.abovebar, color.red, 0, "SELL", textcolor=color.white)

// Explicit output
plot(close, display = display.none)
