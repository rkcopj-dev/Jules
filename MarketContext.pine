//@version=6
indicator("Market Context", overlay=true, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
grp_struct = "Market Structure"
len_left   = input.int(5, "Pivot Left Bars", minval=1, group=grp_struct)
len_right  = input.int(5, "Pivot Right Bars", minval=1, group=grp_struct)
col_bull   = input.color(color.green, "Bullish Color", group=grp_struct)
col_bear   = input.color(color.red, "Bearish Color", group=grp_struct)

grp_htf    = "Higher Timeframe Bias"
htf_tf     = input.timeframe("240", "HTF Selection", group=grp_htf)
show_htf_bg= input.bool(true, "Show HTF Background", group=grp_htf)

grp_liq    = "Liquidity"
show_liq   = input.bool(true, "Show Liquidity Lines", group=grp_liq)
liq_lookback = input.int(50, "Liquidity Line Lookback", minval=10, group=grp_liq)

// -----------------------------------------------------------------------------
// MARKET STRUCTURE (BOS / CHoCH)
// -----------------------------------------------------------------------------
// Detect pivots
ph = ta.pivothigh(len_left, len_right)
pl = ta.pivotlow(len_left, len_right)

// State variables for Structure
var int trend = 0 // 0: Undefined, 1: Bullish, -1: Bearish
var float active_high = na
var float active_low = na
var line active_high_line = na
var line active_low_line = na

// On new Pivot High, update active high if we are not currently breaking it
// Actually, strict structure:
// A High is confirmed len_right bars ago.
// If we are in a range, we might have multiple pivots.
// We track the *most recent* pivot high/low as the structural point.

if not na(ph)
    active_high := ph
    // Visual: Mark HH/LH?
    // label.new(bar_index[len_right], ph, "PH", style=label.style_label_down, color=color.gray, size=size.tiny)

if not na(pl)
    active_low := pl
    // label.new(bar_index[len_right], pl, "PL", style=label.style_label_up, color=color.gray, size=size.tiny)

// Check for Breaks (BOS / CHoCH) on Candle Close
// We only check if the structure point exists
break_up = not na(active_high) and close > active_high
break_down = not na(active_low) and close < active_low

// To avoid repetitive signals for the same break, we can track the last break time or level.
// Or we only trigger when 'trend' state flips or confirms.
// Simpler: If we break, we update the structure.

// Variable to debounce breaks
var int last_break_bar = 0

if barstate.isconfirmed
    if break_up and trend != 1
        // Bearish -> Bullish : CHoCH
        trend := 1
        label.new(bar_index, high, "CHoCH", color=col_bull, style=label.style_label_down, textcolor=color.white, size=size.small)
        // Reset active high to avoid re-triggering until a new pivot forms?
        // Typically after a break, we wait for a new pivot to define the new range.
        active_high := na
        last_break_bar := bar_index

    else if break_up and trend == 1 and bar_index != last_break_bar
        // Bullish -> Bullish Continuation : BOS
        // Only if we broke a *new* high?
        // Since we set active_high = na after break, we need a NEW ph to set it again.
        // So this logic works.
        label.new(bar_index, high, "BOS", color=col_bull, style=label.style_none, textcolor=col_bull)
        active_high := na
        last_break_bar := bar_index

    if break_down and trend != -1
        // Bullish -> Bearish : CHoCH
        trend := -1
        label.new(bar_index, low, "CHoCH", color=col_bear, style=label.style_label_up, textcolor=color.white, size=size.small)
        active_low := na
        last_break_bar := bar_index

    else if break_down and trend == -1 and bar_index != last_break_bar
        // Bearish Continuation : BOS
        label.new(bar_index, low, "BOS", color=col_bear, style=label.style_none, textcolor=col_bear)
        active_low := na
        last_break_bar := bar_index

// -----------------------------------------------------------------------------
// HIGHER TIMEFRAME BIAS
// -----------------------------------------------------------------------------
// Helper to calculate all HTF data
get_htf_data() =>
    [_, _, v_adx] = ta.dmi(14, 14)
    [close, ta.ema(close, 50), ta.ema(close, 200), v_adx]

// Request security once
[htf_close, htf_ema50, htf_ema200, htf_adx] = request.security(syminfo.tickerid, htf_tf, get_htf_data())

// Bias Logic
// Bullish: Close > EMA 50
// Bearish: Close < EMA 50
// Range: ADX < 20

var string bias = "Neutral"
var color bg_color = na

if htf_adx < 20
    bias := "Range"
    bg_color := color.new(color.gray, 90)
else if htf_close > htf_ema50
    bias := "Bullish"
    bg_color := color.new(color.green, 95)
else
    bias := "Bearish"
    bg_color := color.new(color.red, 95)

if show_htf_bg
    bgcolor(bg_color)

// Display HTF Bias Label
// var table bias_tbl = table.new(position.top_right, 1, 1)
// if barstate.islast
//     table.cell(bias_tbl, 0, 0, "HTF Bias (" + htf_tf + "): " + bias, bgcolor=color.new(color.black, 0), text_color=color.white)


// -----------------------------------------------------------------------------
// LIQUIDITY (Buy-side / Sell-side) & SWEEPS
// -----------------------------------------------------------------------------
// Store lines in an array to manage them
// BSL: Buy Side Liquidity (above Highs)
// SSL: Sell Side Liquidity (below Lows)

// We draw lines at Pivot Highs and Lows that haven't been swept.
// When price sweeps them, we alert/label and remove the line (or mark it swept).

// Arrays to store active liquidity lines and their price levels
var line[] bsl_lines = array.new_line()
var float[] bsl_prices = array.new_float()
var line[] ssl_lines = array.new_line()
var float[] ssl_prices = array.new_float()

// Add new BSL
if not na(ph) and show_liq
    // Create line
    l = line.new(bar_index[len_right], ph, bar_index, ph, color=color.new(col_bear, 50), style=line.style_dotted)
    array.push(bsl_lines, l)
    array.push(bsl_prices, ph)
    // Clean up old lines if too many
    if array.size(bsl_lines) > liq_lookback
        line.delete(array.shift(bsl_lines))
        array.shift(bsl_prices)

// Add new SSL
if not na(pl) and show_liq
    l = line.new(bar_index[len_right], pl, bar_index, pl, color=color.new(col_bull, 50), style=line.style_dotted)
    array.push(ssl_lines, l)
    array.push(ssl_prices, pl)
    if array.size(ssl_lines) > liq_lookback
        line.delete(array.shift(ssl_lines))
        array.shift(ssl_prices)

// Extend lines
if barstate.islast and show_liq
    if array.size(bsl_lines) > 0
        for i = 0 to array.size(bsl_lines) - 1
            line.set_x2(array.get(bsl_lines, i), bar_index + 5)
    if array.size(ssl_lines) > 0
        for i = 0 to array.size(ssl_lines) - 1
            line.set_x2(array.get(ssl_lines, i), bar_index + 5)

// Check for Sweeps
// Sweep: Wick crosses level, but Close is reverse.
// For BSL (Resistance): High > Level, Close < Level.
// For SSL (Support): Low < Level, Close > Level.

if show_liq and array.size(bsl_lines) > 0
    // We iterate backwards to safely remove items if needed
    for i = array.size(bsl_lines) - 1 to 0
        lvl = array.get(bsl_prices, i)
        // Check Sweep
        if high > lvl and close < lvl
            // Valid Sweep
            label.new(bar_index, high, "Sweep", style=label.style_label_down, color=color.orange, size=size.tiny, textcolor=color.white)
            // Remove line as liquidity is taken
            line.delete(array.get(bsl_lines, i))
            array.remove(bsl_lines, i)
            array.remove(bsl_prices, i)
        else if close > lvl
            // Break / Taken (not a sweep, just broken)
            // We also remove it because liquidity is used? Or keep it as support?
            // Usually, once broken, it's no longer "Liquidity" in the same sense.
            line.delete(array.get(bsl_lines, i))
            array.remove(bsl_lines, i)
            array.remove(bsl_prices, i)

if show_liq and array.size(ssl_lines) > 0
    for i = array.size(ssl_lines) - 1 to 0
        lvl = array.get(ssl_prices, i)
        // Check Sweep
        if low < lvl and close > lvl
            // Valid Sweep
            label.new(bar_index, low, "Sweep", style=label.style_label_up, color=color.orange, size=size.tiny, textcolor=color.white)
            line.delete(array.get(ssl_lines, i))
            array.remove(ssl_lines, i)
            array.remove(ssl_prices, i)
        else if close < lvl
            // Break
            line.delete(array.get(ssl_lines, i))
            array.remove(ssl_lines, i)
            array.remove(ssl_prices, i)
